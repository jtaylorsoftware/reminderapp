<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_main"
    app:startDestination="@id/fragment_reminders">

    <fragment
        android:id="@+id/fragment_reminders"
        android:name="app.timetoremind.mobile.screens.reminder.overview.RemindersFragment"
        android:label="Reminders"
        tools:layout="@layout/fragment_reminders">
        <action
            android:id="@+id/action_fragment_reminders_to_historyFragment"
            app:destination="@id/fragment_history" />
        <action
            android:id="@+id/action_fragment_reminders_to_reminderEditorActivity"
            app:destination="@id/activity_reminder_editor"
            app:launchSingleTop="true">
            <argument
                android:name="app.timetoremind.mobile.EXTRA_REMINDER_ID"
                android:defaultValue="@null" />
            <argument
                android:name="app.timetoremind.mobile.EXTRA_REMINDER_START_DATE"
                android:defaultValue="@null" />
        </action>
        <action
            android:id="@+id/action_fragment_reminders_to_calendarFragment"
            app:destination="@id/fragment_calendar" />
        <action
            android:id="@+id/action_fragment_reminders_to_alarmListFragment"
            app:destination="@id/fragment_alarm_list" />
    </fragment>
    <fragment
        android:id="@+id/fragment_history"
        android:name="app.timetoremind.mobile.screens.reminder.history.HistoryFragment"
        android:label="History"
        tools:layout="@layout/fragment_history" />
    <activity
        android:id="@+id/activity_reminder_editor"
        android:name="app.timetoremind.mobile.screens.reminder.editor.ReminderEditorActivity"
        tools:layout="@layout/fragment_reminder_editor">
        <argument
            android:name="app.timetoremind.mobile.EXTRA_REMINDER_ID"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="app.timetoremind.mobile.EXTRA_REMINDER_START_DATE"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </activity>
    <fragment
        android:id="@+id/fragment_calendar"
        android:name="app.timetoremind.mobile.screens.reminder.calendar.CalendarFragment"
        android:label="Calendar">
        <action
            android:id="@+id/action_fragment_calendar_to_activity_reminder_editor"
            app:destination="@id/activity_reminder_editor"
            app:launchSingleTop="true">
            <argument
                android:name="app.timetoremind.mobile.EXTRA_REMINDER_ID"
                android:defaultValue="@null" />
            <argument
                android:name="app.timetoremind.mobile.EXTRA_REMINDER_START_DATE"
                android:defaultValue="@null" />
        </action>
    </fragment>
    <fragment
        android:id="@+id/fragment_alarm_list"
        android:name="app.timetoremind.mobile.screens.reminder.alarm.AlarmListFragment"
        android:label="Alarms">
        <action
            android:id="@+id/action_alarmListFragment_to_activity_reminder_editor"
            app:destination="@id/activity_reminder_editor"
            app:launchSingleTop="true">
            <argument
                android:name="app.timetoremind.mobile.EXTRA_REMINDER_ID"
                android:defaultValue="@null" />
            <argument
                android:name="app.timetoremind.mobile.EXTRA_REMINDER_START_DATE"
                android:defaultValue="@null" />
        </action>
    </fragment>
</navigation>