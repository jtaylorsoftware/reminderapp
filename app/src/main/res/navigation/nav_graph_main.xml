<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_main"
    app:startDestination="@id/fragment_reminders">

    <fragment
        android:id="@+id/fragment_reminders"
        android:name="com.github.jeremyt135.reminderapp.screens.reminder.overview.RemindersFragment"
        android:label="Reminders"
        tools:layout="@layout/fragment_reminders">
        <action
            android:id="@+id/action_fragment_reminders_to_historyFragment"
            app:destination="@id/fragment_history" />
        <action
            android:id="@+id/action_fragment_reminders_to_reminderEditorActivity"
            app:destination="@id/activity_reminder_editor" >
            <argument
                android:name="com.github.jeremyt135.reminderapp.EXTRA_REMINDER_ID"
                android:defaultValue='""' />
        </action>
        <action
            android:id="@+id/action_fragment_reminders_to_calendarFragment"
            app:destination="@id/fragment_calendar" />
    </fragment>
    <fragment
        android:id="@+id/fragment_history"
        android:name="com.github.jeremyt135.reminderapp.screens.reminder.history.HistoryFragment"
        android:label="History"
        tools:layout="@layout/fragment_history"/>
    <activity
        android:id="@+id/activity_reminder_editor"
        android:name="com.github.jeremyt135.reminderapp.screens.reminder.editor.ReminderEditorActivity"
        tools:layout="@layout/fragment_reminder_editor">
        <argument
            android:name="com.github.jeremyt135.reminderapp.EXTRA_REMINDER_ID"
            app:argType="string" />
    </activity>
    <fragment
        android:id="@+id/fragment_calendar"
        android:name="com.github.jeremyt135.reminderapp.screens.reminder.calendar.CalendarFragment"
        android:label="Calendar" />
</navigation>