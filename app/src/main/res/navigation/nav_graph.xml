<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/fragment_reminders">

    <fragment
        android:id="@+id/fragment_reminders"
        android:name="com.github.jeremyt135.reminderapp.screens.reminder.overview.RemindersFragment"
        android:label="OverviewFragment"
        tools:layout="@layout/fragment_reminders">
        <action
            android:id="@+id/action_fragment_reminders_to_fragment_reminder_editor"
            app:destination="@id/fragment_reminder_editor" >
            <argument
                android:name="reminderId"
                android:defaultValue="0L" />
        </action>
    </fragment>
    <fragment
        android:id="@+id/fragment_reminder_editor"
        android:name="com.github.jeremyt135.reminderapp.screens.reminder.editor.ReminderEditorFragment"
        android:label="ReminderEditorFragment"
        tools:layout="@layout/fragment_reminder_editor" >
        <argument
            android:name="reminderId"
            app:argType="long" />
    </fragment>
</navigation>