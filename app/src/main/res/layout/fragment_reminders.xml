<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="model"
            type="com.github.jeremyt135.reminderapp.screens.reminder.overview.RemindersViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        tools:context=".reminderapp.screens.reminder.overview.RemindersFragment">

        <TextView
            android:id="@+id/text_reminders_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:onClick="@{() -> model.addReminder()}"
            android:text="@string/reminders_empty_hint"
            android:visibility="@{model.reminders.size() > 0 ? View.GONE : View.VISIBLE}"
            style="@style/Widget.App.RecyclerList.Hint" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_reminders_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="@{model.reminders.size() == 0 ? View.GONE : View.VISIBLE}"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:reminderListData="@{model.reminders}"
            tools:listitem="@layout/item_reminder" />

    </LinearLayout>
</layout>