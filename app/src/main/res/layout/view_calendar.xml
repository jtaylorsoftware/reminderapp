<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="model"
            type="app.timetoremind.mobile.screens.reminder.calendar.CalendarViewModel" />
    </data>

    <merge
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_calendar"
            style="@style/Widget.App.CardView.Calendar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toTopOf="@+id/card_calendar_reminderList"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0"
            app:layout_constraintVertical_chainStyle="packed">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="8dp">

                <TextView
                    android:id="@+id/text_calendar_monthYear"
                    style="@style/TextAppearance.App.Calendar.YearMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="@{model.selectedYearMonthString}"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toTopOf="@+id/recycler_calendar"
                    app:layout_constraintEnd_toStartOf="@+id/button_calendar_forward"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/button_calendar_backward"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0"
                    app:layout_constraintVertical_chainStyle="packed"
                    tools:text="September 00" />

                <ImageButton
                    android:id="@+id/button_calendar_forward"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@color/transparent"
                    android:contentDescription="@string/button_next_month_description"
                    app:layout_constraintBottom_toBottomOf="@+id/text_calendar_monthYear"
                    app:layout_constraintEnd_toEndOf="@+id/recycler_calendar"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/text_calendar_monthYear"
                    app:layout_constraintTop_toTopOf="@+id/text_calendar_monthYear"
                    app:srcCompat="@drawable/ic_baseline_arrow_forward_24" />

                <ImageButton
                    android:id="@+id/button_calendar_backward"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@color/transparent"
                    android:contentDescription="@string/button_previous_month_description"
                    app:layout_constraintBottom_toBottomOf="@+id/text_calendar_monthYear"
                    app:layout_constraintEnd_toStartOf="@+id/text_calendar_monthYear"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:layout_constraintStart_toStartOf="@+id/recycler_calendar"
                    app:layout_constraintTop_toTopOf="@+id/text_calendar_monthYear"
                    app:srcCompat="@drawable/ic_baseline_arrow_back_24" />


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_calendar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:calendarData="@{model.calendarData}"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/text_calendar_monthYear"
                    tools:itemCount="42"
                    tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    tools:layout_height="250dp"
                    tools:listitem="@layout/item_calendar_day"
                    tools:spanCount="7" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_calendar_reminderList"
            style="@style/Widget.App.CardView.Calendar.ReminderList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_calendar"
            app:layout_constraintHeight_percent="0.5">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="8dp"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/text_calendar_reminder_heading"
                    style="@style/TextAppearance.MaterialComponents.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/calendar_reminder_heading"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/text_calendar_reminder_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="@{model.remindersOnSelectedDate.size() > 0 ? View.GONE : View.VISIBLE}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/text_calendar_reminder_heading" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_calendar_reminders"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:fadeScrollbars="true"
                    android:nestedScrollingEnabled="false"
                    android:orientation="vertical"
                    android:scrollbarSize="3dp"
                    android:scrollbarStyle="insideOverlay"
                    android:scrollbars="vertical"
                    android:visibility="@{model.remindersOnSelectedDate.size() == 0 ? View.GONE : View.VISIBLE}"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/text_calendar_reminder_heading"
                    app:reminderWithColorListData="@{model.remindersOnSelectedDate}"
                    tools:listitem="@layout/item_reminder" />

                <Button
                    android:id="@+id/button_calendar_add"
                    style="@style/Widget.App.Button.Compact.Round"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/calendar_addReminder_content_description"
                    android:enabled="@{model.selectedDate != null}"
                    app:icon="@drawable/ic_baseline_add_24"
                    app:layout_constraintBaseline_toBaselineOf="@+id/text_calendar_reminder_heading"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>
    </merge>
</layout>