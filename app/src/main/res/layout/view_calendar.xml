<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="model"
            type="com.github.jeremyt135.reminderapp.screens.reminder.calendar.CalendarViewModel" />
    </data>

    <merge
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:layout_height="match_parent"
        tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

        <TextView
            android:id="@+id/text_calendar_monthYear"
            style="@style/TextAppearance.MaterialComponents.Headline5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@{model.selectedYearMonthString}"
            app:layout_constraintEnd_toStartOf="@+id/button_calendar_forward"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/button_calendar_backward"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="September 00" />

        <ImageButton
            android:id="@+id/button_calendar_forward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:background="@color/transparent"
            android:contentDescription="Next month"
            app:layout_constraintBottom_toBottomOf="@+id/text_calendar_monthYear"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/text_calendar_monthYear"
            app:layout_constraintTop_toTopOf="@+id/text_calendar_monthYear"
            app:srcCompat="@drawable/ic_baseline_arrow_forward_24" />

        <ImageButton
            android:id="@+id/button_calendar_backward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:background="@color/transparent"
            android:contentDescription="Previous month"
            app:layout_constraintBottom_toBottomOf="@+id/text_calendar_monthYear"
            app:layout_constraintEnd_toStartOf="@+id/text_calendar_monthYear"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/text_calendar_monthYear"
            app:srcCompat="@drawable/ic_baseline_arrow_back_24" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_calendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintEnd_toEndOf="@+id/button_calendar_forward"
            app:layout_constraintStart_toStartOf="@+id/button_calendar_backward"
            app:layout_constraintTop_toBottomOf="@+id/text_calendar_monthYear"
            app:spanCount="7"
            tools:itemCount="42"
            tools:layout_height="250dp"
            tools:listitem="@layout/item_calendar_day" />

        <TextView
            android:id="@+id/text_calendar_reminder_heading"
            style="@style/TextAppearance.MaterialComponents.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:text="@string/calendar_reminder_heading"
            app:layout_constraintEnd_toStartOf="@+id/divider5"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/divider6"
            app:layout_constraintTop_toBottomOf="@+id/recycler_calendar" />

        <TextView
            android:id="@+id/text_calendar_reminder_empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/calendar_reminder_empty_hint"
            android:visibility="@{model.remindersOnSelectedDate.size() > 0 ? View.GONE : View.VISIBLE}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_calendar_reminder_heading" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_calendar_reminders"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fadeScrollbars="true"
            android:orientation="vertical"
            android:visibility="@{model.remindersOnSelectedDate.size() == 0 ? View.GONE : View.VISIBLE}"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="@+id/recycler_calendar"
            app:layout_constraintStart_toStartOf="@+id/recycler_calendar"
            app:layout_constraintTop_toBottomOf="@+id/text_calendar_reminder_heading"
            app:reminderListData="@{model.remindersOnSelectedDate}"
            tools:listitem="@layout/item_reminder" />

        <View
            android:id="@+id/divider5"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            app:layout_constraintBottom_toBottomOf="@+id/text_calendar_reminder_heading"
            app:layout_constraintEnd_toEndOf="@+id/recycler_calendar"
            app:layout_constraintStart_toEndOf="@+id/text_calendar_reminder_heading"
            app:layout_constraintTop_toTopOf="@+id/text_calendar_reminder_heading" />

        <View
            android:id="@+id/divider6"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            app:layout_constraintBottom_toBottomOf="@+id/text_calendar_reminder_heading"
            app:layout_constraintEnd_toStartOf="@+id/text_calendar_reminder_heading"
            app:layout_constraintStart_toStartOf="@+id/recycler_calendar"
            app:layout_constraintTop_toTopOf="@+id/text_calendar_reminder_heading" />

    </merge>
</layout>