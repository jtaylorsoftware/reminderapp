<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/calendar_cell_width"
    android:layout_height="@dimen/calendar_cell_height"
    android:paddingHorizontal="@dimen/calendar_cell_padding_h"
    android:paddingVertical="@dimen/calendar_cell_padding_v"
    android:layout_marginHorizontal="@dimen/calendar_cell_margin_h"
    android:layout_marginVertical="@dimen/calendar_cell_margin_v"
    android:foregroundGravity="center">

    <ImageView
        android:id="@+id/image_calendar_dayOfMonth"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible"
        tools:srcCompat="@drawable/bg_calendar_day_outline"/>

    <TextView
        android:id="@+id/text_calendar_dayOfMonth"
        style="@style/TextAppearance.MaterialComponents.Subtitle2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="01" />

    <ImageView
        android:id="@+id/image_calendar_reminderIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_calendar_dayOfMonth"
        app:layout_constraintVertical_bias="0.25"
        tools:srcCompat="@drawable/ic_calendar_reminder_indicator"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
