<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <ScrollView
        android:id="@+id/scrollView_dialogReminderFilter_contents"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/text_dialogReminderFilter_dayOfWeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/dialog_reminderFilter_dayOfWeek_title"
                android:textColor="@color/text_secondary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <CheckBox
                android:id="@+id/checkbox_dialogReminderFilter_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dialog_reminderFilter_today"
                app:layout_constraintEnd_toStartOf="@+id/checkbox_dialogReminderFilter_thursday"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_dialogReminderFilter_dayOfWeek" />

            <CheckBox
                android:id="@+id/checkbox_dialogReminderFilter_monday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dialog_reminderFilter_mondays"
                app:layout_constraintStart_toStartOf="@+id/checkbox_dialogReminderFilter_today"
                app:layout_constraintTop_toBottomOf="@+id/checkbox_dialogReminderFilter_today" />

            <CheckBox
                android:id="@+id/checkbox_dialogReminderFilter_tuesday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dialog_reminderFilter_tuesdays"
                app:layout_constraintStart_toStartOf="@+id/checkbox_dialogReminderFilter_monday"
                app:layout_constraintTop_toBottomOf="@+id/checkbox_dialogReminderFilter_monday" />

            <CheckBox
                android:id="@+id/checkbox_dialogReminderFilter_wednesday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dialog_reminderFilter_wednesdays"
                app:layout_constraintStart_toStartOf="@+id/checkbox_dialogReminderFilter_tuesday"
                app:layout_constraintTop_toBottomOf="@+id/checkbox_dialogReminderFilter_tuesday" />

            <CheckBox
                android:id="@+id/checkbox_dialogReminderFilter_thursday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_reminderFilter_thursdays"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/checkbox_dialogReminderFilter_today"
                app:layout_constraintTop_toTopOf="@+id/checkbox_dialogReminderFilter_today" />

            <CheckBox
                android:id="@+id/checkbox_dialogReminderFilter_friday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dialog_reminderFilter_fridays"
                app:layout_constraintStart_toStartOf="@+id/checkbox_dialogReminderFilter_thursday"
                app:layout_constraintTop_toBottomOf="@+id/checkbox_dialogReminderFilter_thursday" />

            <CheckBox
                android:id="@+id/checkbox_dialogReminderFilter_saturday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dialog_reminderFilter_saturdays"
                app:layout_constraintStart_toStartOf="@+id/checkbox_dialogReminderFilter_friday"
                app:layout_constraintTop_toBottomOf="@+id/checkbox_dialogReminderFilter_friday" />

            <CheckBox
                android:id="@+id/checkbox_dialogReminderFilter_sunday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dialog_reminderFilter_sundays"
                app:layout_constraintStart_toStartOf="@+id/checkbox_dialogReminderFilter_saturday"
                app:layout_constraintTop_toBottomOf="@+id/checkbox_dialogReminderFilter_saturday" />

            <TextView
                android:id="@+id/text_dialogReminderFilter_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="312dp"
                android:text="@string/dialog_reminderFilter_completion_title"
                android:textColor="@color/text_secondary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <CheckBox
                android:id="@+id/checkbox_dialogReminderFilter_pending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dialog_reminderFilter_pending"
                app:layout_constraintEnd_toStartOf="@+id/checkbox_dialogReminderFilter_skipped"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_dialogReminderFilter_status" />

            <CheckBox
                android:id="@+id/checkbox_dialogReminderFilter_skipped"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_reminderFilter_skipped"
                app:layout_constraintEnd_toStartOf="@+id/checkbox_dialogReminderFilter_completed"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/checkbox_dialogReminderFilter_pending"
                app:layout_constraintTop_toTopOf="@+id/checkbox_dialogReminderFilter_pending" />

            <CheckBox
                android:id="@+id/checkbox_dialogReminderFilter_completed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_reminderFilter_completed"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/checkbox_dialogReminderFilter_skipped"
                app:layout_constraintTop_toTopOf="@+id/checkbox_dialogReminderFilter_skipped" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</layout>