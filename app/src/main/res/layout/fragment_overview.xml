<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.example.reminderapp.screens.todo.overview.OverviewViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_layout_overview_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".screens.todo.overview.OverviewFragment">


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_overview_reminder_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:reminderListData="@{viewModel.reminders}"
            tools:layout_editor_absoluteX="142dp"
            tools:layout_editor_absoluteY="75dp"
            tools:listitem="@layout/item_reminder"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_overview_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_overview_small"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/overview_fab_description"
            android:src="@drawable/ic_baseline_add_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>