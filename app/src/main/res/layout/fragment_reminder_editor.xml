<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <import type="androidx.lifecycle.LiveData" />

        <import type="com.github.jeremyt135.reminderapp.data.domain.Reminder" />

        <variable
            name="model"
            type="com.github.jeremyt135.reminderapp.screens.reminder.editor.ReminderEditorViewModel" />

        <variable
            name="reminder"
            type="LiveData&lt;Reminder&gt;" />
    </data>

    <ScrollView
        android:id="@+id/scrollView_editor_contents"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:context=".reminderapp.screens.reminder.editor.ReminderEditorFragment">

            <TimePicker
                android:id="@+id/timePicker_editor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:timePickerMode="spinner"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.445"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/edit_editor_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:hint="@string/editor_descriptionEdit_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text"
                android:text="@={reminder.description}"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/timePicker_editor"
                tools:text="Reminder text" />

            <ToggleButton
                android:id="@+id/toggle_editor_sunday"
                android:layout_width="@dimen/dateToggleSize_editor"
                android:layout_height="@dimen/dateToggleSize_editor"
                android:layout_marginStart="32dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/ic_toggle_36"
                android:checked="@{reminder.schedulingRules.dayIsScheduled(`SUNDAY`)}"
                android:onClick="@{() -> model.toggleDay(`SUNDAY`)}"
                android:textOff="@string/sunday_abbrev"
                android:textOn="@string/sunday_abbrev"
                app:layout_constraintEnd_toStartOf="@+id/toggle_editor_monday"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_editor_scheduleLabel" />

            <ToggleButton
                android:id="@+id/toggle_editor_monday"
                android:layout_width="@dimen/dateToggleSize_editor"
                android:layout_height="@dimen/dateToggleSize_editor"
                android:background="@drawable/ic_toggle_36"
                android:checked="@{reminder.schedulingRules.dayIsScheduled(`MONDAY`)}"
                android:onClick="@{() -> model.toggleDay(`MONDAY`)}"
                android:textOff="@string/monday_abbrev"
                android:textOn="@string/monday_abbrev"
                app:layout_constraintEnd_toStartOf="@+id/toggle_editor_tuesday"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/toggle_editor_sunday"
                app:layout_constraintTop_toTopOf="@+id/toggle_editor_sunday" />

            <ToggleButton
                android:id="@+id/toggle_editor_tuesday"
                android:layout_width="@dimen/dateToggleSize_editor"
                android:layout_height="@dimen/dateToggleSize_editor"
                android:background="@drawable/ic_toggle_36"
                android:checked="@{reminder.schedulingRules.dayIsScheduled(`TUESDAY`)}"
                android:onClick="@{() -> model.toggleDay(`TUESDAY`)}"
                android:textOff="@string/tuesday_abbrev"
                android:textOn="@string/tuesday_abbrev"
                app:layout_constraintEnd_toStartOf="@+id/toggle_editor_wednesday"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/toggle_editor_monday"
                app:layout_constraintTop_toTopOf="@+id/toggle_editor_monday" />

            <ToggleButton
                android:id="@+id/toggle_editor_wednesday"
                android:layout_width="@dimen/dateToggleSize_editor"
                android:layout_height="@dimen/dateToggleSize_editor"
                android:background="@drawable/ic_toggle_36"
                android:checked="@{reminder.schedulingRules.dayIsScheduled(`WEDNESDAY`)}"
                android:onClick="@{() -> model.toggleDay(`WEDNESDAY`)}"
                android:textOff="@string/wednesday_abbrev"
                android:textOn="@string/wednesday_abbrev"
                app:layout_constraintEnd_toStartOf="@+id/toggle_editor_thursday"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/toggle_editor_tuesday"
                app:layout_constraintTop_toTopOf="@+id/toggle_editor_tuesday" />

            <ToggleButton
                android:id="@+id/toggle_editor_thursday"
                android:layout_width="@dimen/dateToggleSize_editor"
                android:layout_height="@dimen/dateToggleSize_editor"
                android:background="@drawable/ic_toggle_36"
                android:checked="@{reminder.schedulingRules.dayIsScheduled(`THURSDAY`)}"
                android:onClick="@{() -> model.toggleDay(`THURSDAY`)}"
                android:textOff="@string/thursday_abbrev"
                android:textOn="@string/thursday_abbrev"
                app:layout_constraintEnd_toStartOf="@+id/toggle_editor_friday"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/toggle_editor_wednesday"
                app:layout_constraintTop_toTopOf="@+id/toggle_editor_wednesday" />

            <ToggleButton
                android:id="@+id/toggle_editor_friday"
                android:layout_width="@dimen/dateToggleSize_editor"
                android:layout_height="@dimen/dateToggleSize_editor"
                android:background="@drawable/ic_toggle_36"
                android:checked="@{reminder.schedulingRules.dayIsScheduled(`FRIDAY`)}"
                android:onClick="@{() -> model.toggleDay(`FRIDAY`)}"
                android:textOff="@string/friday_abbrev"
                android:textOn="@string/friday_abbrev"
                app:layout_constraintEnd_toStartOf="@+id/toggle_editor_saturday"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/toggle_editor_thursday"
                app:layout_constraintTop_toTopOf="@+id/toggle_editor_thursday" />

            <ToggleButton
                android:id="@+id/toggle_editor_saturday"
                android:layout_width="@dimen/dateToggleSize_editor"
                android:layout_height="@dimen/dateToggleSize_editor"
                android:layout_marginEnd="32dp"
                android:background="@drawable/ic_toggle_36"
                android:checked="@{reminder.schedulingRules.dayIsScheduled(`SATURDAY`)}"
                android:onClick="@{() -> model.toggleDay(`SATURDAY`)}"
                android:textOff="@string/saturday_abbrev"
                android:textOn="@string/saturday_abbrev"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/toggle_editor_friday"
                app:layout_constraintTop_toTopOf="@+id/toggle_editor_friday" />

            <TextView
                android:id="@+id/text_editor_scheduleLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="@dimen/margin_editor_small"
                android:layout_marginEnd="32dp"
                android:scrollHorizontally="false"
                android:text="@{model.reminderDaysDisplayString}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/edit_editor_description"
                tools:text="Every day" />


            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_editor_vibrate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                android:checked="@={reminder.vibrate}"
                android:text="@string/editor_switch_vibrate"
                app:layout_constraintEnd_toStartOf="@+id/switch_editor_sound"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/toggle_editor_sunday" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_editor_sound"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="32dp"
                android:checked="@{!model.selectedSound.equals(`None`)}"
                android:text="@{`Sound: ` + model.selectedSound}"
                app:layout_constraintBottom_toBottomOf="@+id/switch_editor_vibrate"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/switch_editor_vibrate"
                app:layout_constraintTop_toTopOf="@+id/switch_editor_vibrate"
                tools:text="Sound: None" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_editor_cancel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="@{() -> model.cancel()}"
                    android:text="@string/editor_cancel"
                    android:textColor="@color/white"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_editor_delete"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    android:onClick="@{() -> model.deleteReminder()}"
                    android:text="@string/editor_delete"
                    android:textColor="@color/white"
                    android:visibility="@{model.editing ? View.VISIBLE : View.GONE}"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_editor_save"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="@{() -> model.saveReminder()}"
                    android:text="@string/editor_save"
                    android:textColor="@color/white"
                    app:cornerRadius="8dp" />

            </LinearLayout>


            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_editor_maxSnoozeRepeats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="@{model.canChangeSnoozeRepetitions ? View.VISIBLE : View.GONE}"
                app:constraint_referenced_ids="text_editor_maxSnoozeRepeatsLabel, edit_editor_maxSnoozeRepeats" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textinput_editor_maxSnoozeRepeats"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="16dp"
                android:hint="@string/editor_hint_snoozeMaxRepeats"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/switch_editor_vibrate">

                <AutoCompleteTextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/text_editor_maxSnoozeRepeatsLabel"
                android:layout_width="124dp"
                android:layout_height="45dp"
                android:layout_marginStart="32dp"
                android:ems="10"
                android:gravity="center_vertical"
                android:text="@string/editor_label_maxSnoozeRepeats"
                app:layout_constraintBottom_toBottomOf="@+id/edit_editor_maxSnoozeRepeats"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/edit_editor_maxSnoozeRepeats" />

            <EditText
                android:id="@+id/edit_editor_maxSnoozeRepeats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:ems="4"
                android:gravity="center_horizontal"
                android:inputType="numberSigned"
                android:maxLength="2"
                android:maxLines="1"
                android:text="@={`` + reminder.maxSnoozeRepeats}"
                app:layout_constraintStart_toEndOf="@+id/text_editor_maxSnoozeRepeatsLabel"
                app:layout_constraintTop_toBottomOf="@+id/textinput_editor_maxSnoozeRepeats" />

            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_editor_snoozeDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="@{reminder.maxSnoozeRepeats > 0 &amp;&amp; model.canChangeSnoozeDuration ? View.VISIBLE : View.GONE}"
                app:constraint_referenced_ids="text_editor_snoozeDurationLabel, edit_editor_snoozeDuration" />

            <EditText
                android:id="@+id/edit_editor_snoozeDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:ems="4"
                android:gravity="center_horizontal"
                android:inputType="numberSigned"
                android:maxLength="2"
                android:maxLines="1"
                android:text="@={`` + reminder.snoozeDuration}"
                app:layout_constraintStart_toEndOf="@+id/text_editor_snoozeDurationLabel"
                app:layout_constraintTop_toBottomOf="@+id/edit_editor_maxSnoozeRepeats" />

            <TextView
                android:id="@+id/text_editor_snoozeDurationLabel"
                android:layout_width="124dp"
                android:layout_height="45dp"
                android:layout_marginStart="32dp"
                android:ems="10"
                android:gravity="center_vertical"
                android:text="@string/editor_label_snoozeDuration"
                app:layout_constraintBottom_toBottomOf="@+id/edit_editor_snoozeDuration"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/edit_editor_snoozeDuration"
                app:layout_constraintVertical_bias="1.0" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:gravity="center_vertical"
                android:text="@string/editor_label_snoozeDurationUnit"
                app:layout_constraintBottom_toBottomOf="@+id/edit_editor_snoozeDuration"
                app:layout_constraintStart_toEndOf="@+id/edit_editor_snoozeDuration"
                app:layout_constraintTop_toTopOf="@+id/edit_editor_snoozeDuration" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>


</layout>