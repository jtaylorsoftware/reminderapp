<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <import type="androidx.lifecycle.LiveData" />

        <import type="com.github.jeremyt135.reminderapp.data.domain.Reminder" />

        <variable
            name="model"
            type="com.github.jeremyt135.reminderapp.screens.reminder.editor.ReminderEditorViewModel" />

        <variable
            name="reminder"
            type="LiveData&lt;Reminder&gt;" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView_editor_contents"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent"
        android:fadeScrollbars="true"
        android:paddingHorizontal="4dp"
        android:scrollbarSize="3dp"
        android:scrollbarStyle="insideOverlay"
        android:scrollbars="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            tools:context=".reminderapp.screens.reminder.editor.ReminderEditorFragment">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textlayout_editor_description"
                style="@style/Widget.App.TextInputLayout.OutlinedBox.Editor"
                android:hint="@string/edit_reminder"
                app:boxStrokeErrorColor="@color/error"
                app:errorIconDrawable="@drawable/ic_baseline_error_outline_24"
                app:errorIconTint="@color/error"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:startIconContentDescription="Edit icon"
                app:startIconDrawable="@drawable/ic_baseline_edit_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textinput_editor_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text|textMultiLine"
                    android:maxLength="100"
                    android:scrollHorizontally="false"
                    android:text="@{reminder.description}" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textlayout_editor_startDate"
                style="@style/Widget.App.TextInputLayout.OutlinedBox.Editor"
                android:hint="@string/editor_startDate_hint"
                app:boxStrokeErrorColor="@color/error"
                app:errorEnabled="@{model.startDateState.errorEnabled}"
                app:errorIconDrawable="@drawable/ic_baseline_error_outline_24"
                app:errorIconTint="@color/error"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textlayout_editor_description"
                app:startIconContentDescription="Calendar icon"
                app:startIconDrawable="@drawable/ic_baseline_event_note_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textinput_editor_startDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:text="@{model.startDateString}" />

            </com.google.android.material.textfield.TextInputLayout>

            <CheckBox
                android:id="@+id/checkbox_editor_repeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="@{model.repeats}"
                android:text="@string/editor_checkbox_repeats"
                app:layout_constraintEnd_toStartOf="@+id/checkbox_editor_endDate"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="@+id/textlayout_editor_time"
                app:layout_constraintTop_toBottomOf="@+id/textlayout_editor_time" />

            <CheckBox
                android:id="@+id/checkbox_editor_endDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:checked="@{model.hasEndDate}"
                android:text="@string/editor_checkbox_endDate"
                android:visibility="@{model.repeats ? View.VISIBLE : View.GONE}"
                app:layout_constraintEnd_toEndOf="@+id/textlayout_editor_time"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/checkbox_editor_repeat"
                app:layout_constraintTop_toTopOf="@+id/checkbox_editor_repeat" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textlayout_editor_endDate"
                style="@style/Widget.App.TextInputLayout.OutlinedBox.Editor"
                android:hint="@string/editor_endDate_hint"
                android:visibility="@{model.repeats &amp;&amp; model.hasEndDate ? View.VISIBLE : View.GONE}"
                app:boxStrokeErrorColor="@color/error"
                app:errorEnabled="@{model.endDateState.errorEnabled}"
                app:errorIconDrawable="@drawable/ic_baseline_error_outline_24"
                app:errorIconTint="@color/error"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textlayout_editor_daysOfWeek"
                app:startIconContentDescription="Calendar icon"
                app:startIconDrawable="@drawable/ic_baseline_event_note_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textinput_editor_endDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:text="@{model.endDateString}" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textlayout_editor_daysOfWeek"
                style="@style/Widget.App.TextInputLayout.OutlinedBox.Editor"
                android:hint="@string/editor_daysOfWeek_hint"
                android:visibility="@{model.repeats ? View.VISIBLE : View.GONE}"
                app:boxStrokeErrorColor="@color/error"
                app:errorEnabled="@{model.daysOfWeekState.errorEnabled}"
                app:errorIconDrawable="@drawable/ic_baseline_error_outline_24"
                app:errorIconTint="@color/error"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/checkbox_editor_repeat"
                app:startIconContentDescription="Date range icon"
                app:startIconDrawable="@drawable/ic_baseline_date_range_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textinput_editor_daysOfWeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:text="@{model.reminderDaysDisplayString}" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textlayout_editor_time"
                style="@style/Widget.App.TextInputLayout.OutlinedBox.Editor"
                android:hint="@string/editor_time_hint"
                app:boxStrokeErrorColor="@color/error"
                app:errorEnabled="@{model.timeState.errorEnabled}"
                app:errorIconDrawable="@drawable/ic_baseline_error_outline_24"
                app:errorIconTint="@color/error"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textlayout_editor_startDate"
                app:startIconContentDescription="Clock icon"
                app:startIconDrawable="@drawable/ic_baseline_access_time_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textinput_editor_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:text="@{model.timeDisplayString}" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textlayout_editor_snooze"
                style="@style/Widget.App.TextInputLayout.OutlinedBox.Editor"
                android:hint="@string/editor_snooze_hint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textlayout_editor_endDate"
                app:startIconContentDescription="Snooze icon"
                app:startIconDrawable="@drawable/ic_notification_snooze">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textinput_editor_snooze"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:text="@{model.snoozeDisplayString}" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textlayout_editor_sound"
                style="@style/Widget.App.TextInputLayout.OutlinedBox.Editor"
                android:hint="@string/editor_sound_hint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textlayout_editor_snooze"
                app:startIconContentDescription="Snooze icon"
                app:startIconDrawable="@drawable/ic_notification_alarm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textinput_editor_sound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:text="@{model.vibrateAndSoundDisplayString}" />

            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/button_editor_delete"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:text="@string/delete"
                android:visibility="@{model.editing ? View.VISIBLE : View.GONE}"
                app:layout_constraintEnd_toStartOf="@id/button_editor_save"
                app:layout_constraintTop_toBottomOf="@id/textlayout_editor_sound" />

            <Button
                android:id="@+id/button_editor_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/save"
                app:layout_constraintEnd_toEndOf="@id/textlayout_editor_sound"
                app:layout_constraintTop_toBottomOf="@id/textlayout_editor_sound" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</layout>