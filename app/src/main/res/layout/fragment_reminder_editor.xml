<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />
        <import type="androidx.lifecycle.LiveData" />
        <import type="com.github.jeremyt135.reminderapp.data.domain.SnoozeInterval" />
        <import type="com.github.jeremyt135.reminderapp.data.domain.Reminder" />
        <variable
            name="model"
            type="com.github.jeremyt135.reminderapp.screens.reminder.editor.ReminderEditorViewModel" />

        <variable
            name="reminder"
            type="LiveData&lt;Reminder&gt;"/>
    </data>

    <ScrollView
        android:id="@+id/scrollView_editor_contents"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:context=".reminderapp.screens.reminder.editor.ReminderEditorFragment">

            <TimePicker
                android:id="@+id/timePicker_editor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:timePickerMode="spinner"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.445"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/edit_editor_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/editor_descriptionEdit_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text"
                android:text="@={reminder.description}"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="@+id/text_editor_scheduleLabel"
                app:layout_constraintTop_toBottomOf="@+id/timePicker_editor"
                tools:text="Reminder text" />

            <ToggleButton
                android:id="@+id/toggle_editor_sunday"
                android:layout_width="@dimen/dateToggleSize_editor"
                android:layout_height="@dimen/dateToggleSize_editor"
                android:layout_marginStart="@dimen/margin_editor_small"
                android:layout_marginTop="@dimen/margin_editor_small"
                android:background="@drawable/ic_toggle_36"
                android:checked="@{reminder.dayIsChecked(`SUNDAY`)}"
                android:onClick="@{() -> model.toggleDay(`SUNDAY`)}"
                android:textOff="@string/sunday_abbrev"
                android:textOn="@string/sunday_abbrev"
                app:layout_constraintEnd_toStartOf="@+id/toggle_editor_monday"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_editor_scheduleLabel" />

            <ToggleButton
                android:id="@+id/toggle_editor_monday"
                android:layout_width="@dimen/dateToggleSize_editor"
                android:layout_height="@dimen/dateToggleSize_editor"
                android:background="@drawable/ic_toggle_36"
                android:checked="@{reminder.dayIsChecked(`MONDAY`)}"
                android:onClick="@{() -> model.toggleDay(`MONDAY`)}"
                android:textOff="@string/monday_abbrev"
                android:textOn="@string/monday_abbrev"
                app:layout_constraintBottom_toBottomOf="@+id/toggle_editor_sunday"
                app:layout_constraintEnd_toStartOf="@+id/toggle_editor_tuesday"
                app:layout_constraintStart_toEndOf="@+id/toggle_editor_sunday"
                app:layout_constraintTop_toTopOf="@+id/toggle_editor_sunday" />

            <ToggleButton
                android:id="@+id/toggle_editor_tuesday"
                android:layout_width="@dimen/dateToggleSize_editor"
                android:layout_height="@dimen/dateToggleSize_editor"
                android:background="@drawable/ic_toggle_36"
                android:checked="@{reminder.dayIsChecked(`TUESDAY`)}"
                android:onClick="@{() -> model.toggleDay(`TUESDAY`)}"
                android:textOff="@string/tuesday_abbrev"
                android:textOn="@string/tuesday_abbrev"
                app:layout_constraintBottom_toBottomOf="@+id/toggle_editor_monday"
                app:layout_constraintEnd_toStartOf="@+id/toggle_editor_wednesday"
                app:layout_constraintStart_toEndOf="@+id/toggle_editor_monday"
                app:layout_constraintTop_toTopOf="@+id/toggle_editor_monday" />

            <ToggleButton
                android:id="@+id/toggle_editor_wednesday"
                android:layout_width="@dimen/dateToggleSize_editor"
                android:layout_height="@dimen/dateToggleSize_editor"
                android:background="@drawable/ic_toggle_36"
                android:checked="@{reminder.dayIsChecked(`WEDNESDAY`)}"
                android:onClick="@{() -> model.toggleDay(`WEDNESDAY`)}"
                android:textOff="@string/wednesday_abbrev"
                android:textOn="@string/wednesday_abbrev"
                app:layout_constraintBottom_toBottomOf="@+id/toggle_editor_tuesday"
                app:layout_constraintEnd_toStartOf="@+id/toggle_editor_thursday"
                app:layout_constraintStart_toEndOf="@+id/toggle_editor_tuesday"
                app:layout_constraintTop_toTopOf="@+id/toggle_editor_tuesday" />

            <ToggleButton
                android:id="@+id/toggle_editor_thursday"
                android:layout_width="@dimen/dateToggleSize_editor"
                android:layout_height="@dimen/dateToggleSize_editor"
                android:background="@drawable/ic_toggle_36"
                android:checked="@{reminder.dayIsChecked(`THURSDAY`)}"
                android:onClick="@{() -> model.toggleDay(`THURSDAY`)}"
                android:textOff="@string/thursday_abbrev"
                android:textOn="@string/thursday_abbrev"
                app:layout_constraintBottom_toBottomOf="@+id/toggle_editor_wednesday"
                app:layout_constraintEnd_toStartOf="@+id/toggle_editor_friday"
                app:layout_constraintStart_toEndOf="@+id/toggle_editor_wednesday"
                app:layout_constraintTop_toTopOf="@+id/toggle_editor_wednesday" />

            <ToggleButton
                android:id="@+id/toggle_editor_friday"
                android:layout_width="@dimen/dateToggleSize_editor"
                android:layout_height="@dimen/dateToggleSize_editor"
                android:background="@drawable/ic_toggle_36"
                android:checked="@{reminder.dayIsChecked(`FRIDAY`)}"
                android:onClick="@{() -> model.toggleDay(`FRIDAY`)}"
                android:textOff="@string/friday_abbrev"
                android:textOn="@string/friday_abbrev"
                app:layout_constraintBottom_toBottomOf="@+id/toggle_editor_thursday"
                app:layout_constraintEnd_toStartOf="@+id/toggle_editor_saturday"
                app:layout_constraintStart_toEndOf="@+id/toggle_editor_thursday"
                app:layout_constraintTop_toTopOf="@+id/toggle_editor_thursday" />

            <ToggleButton
                android:id="@+id/toggle_editor_saturday"
                android:layout_width="@dimen/dateToggleSize_editor"
                android:layout_height="@dimen/dateToggleSize_editor"
                android:layout_marginEnd="@dimen/margin_editor_small"
                android:background="@drawable/ic_toggle_36"
                android:checked="@{reminder.dayIsChecked(`SATURDAY`)}"
                android:onClick="@{() -> model.toggleDay(`SATURDAY`)}"
                android:textOff="@string/saturday_abbrev"
                android:textOn="@string/saturday_abbrev"
                app:layout_constraintBottom_toBottomOf="@+id/toggle_editor_friday"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/toggle_editor_friday"
                app:layout_constraintTop_toTopOf="@+id/toggle_editor_friday" />

            <TextView
                android:id="@+id/text_editor_scheduleLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_editor_small"
                android:scrollHorizontally="false"
                android:text="@{model.reminderDaysDisplayString}"
                app:layout_constraintEnd_toEndOf="@+id/toggle_editor_saturday"
                app:layout_constraintStart_toStartOf="@+id/toggle_editor_sunday"
                app:layout_constraintTop_toBottomOf="@+id/edit_editor_description"
                tools:text="Every day" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_editor_vibrate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_editor_medium"
                android:checked="@={reminder.vibrate}"
                android:text="@string/editor_switch_vibrate"
                app:layout_constraintEnd_toEndOf="@+id/textinput_editor_snooze_interval"
                app:layout_constraintStart_toStartOf="@+id/textinput_editor_snooze_interval"
                app:layout_constraintTop_toBottomOf="@+id/toggle_editor_sunday" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textinput_editor_snooze_interval"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/editor_snooze_interval"
                app:layout_constraintStart_toStartOf="@+id/toggle_editor_sunday"
                app:layout_constraintTop_toBottomOf="@+id/switch_editor_vibrate">

                <AutoCompleteTextView
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textinput_editor_snooze_duration"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_editor_small"
                android:hint="@string/editor_snooze_duration"
                android:visibility="@{reminder.snoozeInterval != SnoozeInterval.NEVER ? View.VISIBLE : View.GONE}"
                app:layout_constraintStart_toStartOf="@+id/textinput_editor_snooze_interval"
                app:layout_constraintTop_toBottomOf="@+id/textinput_editor_snooze_interval">

                <AutoCompleteTextView
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textSize="14sp"
                    android:visibility="@{reminder.snoozeInterval != SnoozeInterval.NEVER ? View.VISIBLE : View.GONE}" />

            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_alignParentBottom="true"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textinput_editor_snooze_duration"
                app:layout_constraintVertical_bias="1.0">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_editor_cancel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="@{() -> model.cancel()}"
                    android:text="@string/editor_cancel"
                    android:textColor="@color/white"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_editor_delete"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    android:onClick="@{() -> model.deleteReminder()}"
                    android:text="@string/editor_delete"
                    android:textColor="@color/white"
                    android:visibility="@{model.editing ? View.VISIBLE : View.GONE}"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_editor_save"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:onClick="@{() -> model.saveReminder()}"
                    android:text="@string/editor_save"
                    android:textColor="@color/white"
                    app:cornerRadius="8dp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>


</layout>