<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="java.time.DayOfWeek" />

        <import type="android.view.View" />

        <import type="com.github.jeremyt135.reminderapp.data.domain.SchedulingType" />

        <variable
            name="data"
            type="com.github.jeremyt135.reminderapp.data.domain.ReminderAndHistory" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp">

            <TextView
                android:id="@+id/text_item_reminder_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:text="@{data.reminder.description}"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@+id/text_item_reminder_startDate"
                app:layout_constraintEnd_toStartOf="@+id/divider_item_reminder"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Reminder text" />

            <TextView
                android:id="@+id/text_item_reminder_startDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingBottom="1dp"
                android:text="@{data.reminder.schedulingRules.startDateDisplayString()}"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/textSize_item_reminder_date"
                app:layout_constraintBottom_toTopOf="@+id/text_item_reminder_everyDay"
                app:layout_constraintEnd_toStartOf="@+id/text_item_reminder_until"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_item_reminder_description"
                tools:text="9/5/21" />

            <TextView
                android:id="@+id/text_item_reminder_everyDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingBottom="1dp"
                android:text="@string/every_day"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/textSize_item_reminder_date"
                android:visibility="@{data.reminder.schedulingRules.everyDay ? View.VISIBLE : View.GONE}"
                app:layout_constraintBottom_toTopOf="@+id/text_item_reminder_sunday"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_item_reminder_startDate" />

            <TextView
                android:id="@+id/text_item_reminder_sunday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="2dp"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingBottom="1dp"
                android:text="@string/sunday_abbrev"
                android:textColor="@{data.reminder.schedulingRules.dayIsScheduled(DayOfWeek.SUNDAY) ? @color/color_primary : @color/text_secondary}"
                android:textSize="@dimen/textSize_item_reminder_date"
                android:visibility="@{!data.reminder.schedulingRules.oneOff &amp;&amp; !data.reminder.schedulingRules.everyDay ? View.VISIBLE : View.GONE}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/text_item_reminder_monday"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_item_reminder_everyDay"
                tools:textColor="@color/color_primary" />

            <TextView
                android:id="@+id/text_item_reminder_monday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingBottom="1dp"
                android:text="@string/monday_abbrev"
                android:textColor="@{data.reminder.schedulingRules.dayIsScheduled(DayOfWeek.MONDAY) ? @color/color_primary : @color/text_secondary}"
                android:textSize="@dimen/textSize_item_reminder_date"
                android:visibility="@{!data.reminder.schedulingRules.oneOff &amp;&amp; !data.reminder.schedulingRules.everyDay ? View.VISIBLE : View.GONE}"
                app:layout_constraintBottom_toBottomOf="@+id/text_item_reminder_sunday"
                app:layout_constraintEnd_toStartOf="@+id/text_item_reminder_tuesday"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/text_item_reminder_sunday" />

            <TextView
                android:id="@+id/text_item_reminder_tuesday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingBottom="1dp"
                android:text="@string/tuesday_abbrev"
                android:textColor="@{data.reminder.schedulingRules.dayIsScheduled(DayOfWeek.TUESDAY) ? @color/color_primary : @color/text_secondary}"
                android:textSize="@dimen/textSize_item_reminder_date"
                android:visibility="@{!data.reminder.schedulingRules.oneOff &amp;&amp; !data.reminder.schedulingRules.everyDay ? View.VISIBLE : View.GONE}"
                app:layout_constraintBottom_toBottomOf="@+id/text_item_reminder_monday"
                app:layout_constraintEnd_toStartOf="@+id/text_item_reminder_wednesday"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/text_item_reminder_monday" />

            <TextView
                android:id="@+id/text_item_reminder_wednesday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingBottom="1dp"
                android:text="@string/wednesday_abbrev"
                android:textColor="@{data.reminder.schedulingRules.dayIsScheduled(DayOfWeek.WEDNESDAY) ? @color/color_primary : @color/text_secondary}"
                android:textSize="@dimen/textSize_item_reminder_date"
                android:visibility="@{!data.reminder.schedulingRules.oneOff &amp;&amp; !data.reminder.schedulingRules.everyDay ? View.VISIBLE : View.GONE}"
                app:layout_constraintBottom_toBottomOf="@+id/text_item_reminder_tuesday"
                app:layout_constraintEnd_toStartOf="@+id/text_item_reminder_thursday"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/text_item_reminder_tuesday" />

            <TextView
                android:id="@+id/text_item_reminder_thursday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingBottom="1dp"
                android:text="@string/thursday_abbrev"
                android:textColor="@{data.reminder.schedulingRules.dayIsScheduled(DayOfWeek.THURSDAY) ? @color/color_primary : @color/text_secondary}"
                android:textSize="@dimen/textSize_item_reminder_date"
                android:visibility="@{!data.reminder.schedulingRules.oneOff &amp;&amp; !data.reminder.schedulingRules.everyDay ? View.VISIBLE : View.GONE}"
                app:layout_constraintBottom_toBottomOf="@+id/text_item_reminder_wednesday"
                app:layout_constraintEnd_toStartOf="@+id/text_item_reminder_friday"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/text_item_reminder_wednesday" />

            <TextView
                android:id="@+id/text_item_reminder_friday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingBottom="1dp"
                android:text="@string/friday_abbrev"
                android:textColor="@{data.reminder.schedulingRules.dayIsScheduled(DayOfWeek.FRIDAY) ? @color/color_primary : @color/text_secondary}"
                android:textSize="@dimen/textSize_item_reminder_date"
                android:visibility="@{!data.reminder.schedulingRules.oneOff &amp;&amp; !data.reminder.schedulingRules.everyDay ? View.VISIBLE : View.GONE}"
                app:layout_constraintBottom_toBottomOf="@+id/text_item_reminder_thursday"
                app:layout_constraintEnd_toStartOf="@+id/text_item_reminder_saturday"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/text_item_reminder_thursday" />

            <TextView
                android:id="@+id/text_item_reminder_saturday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingBottom="1dp"
                android:text="@string/saturday_abbrev"
                android:textColor="@{data.reminder.schedulingRules.dayIsScheduled(DayOfWeek.SATURDAY) ? @color/color_primary : @color/text_secondary}"
                android:textSize="@dimen/textSize_item_reminder_date"
                android:visibility="@{!data.reminder.schedulingRules.oneOff &amp;&amp; !data.reminder.schedulingRules.everyDay ? View.VISIBLE : View.GONE}"
                app:layout_constraintBottom_toBottomOf="@+id/text_item_reminder_friday"
                app:layout_constraintStart_toEndOf="@+id/text_item_reminder_friday" />

            <View
                android:id="@+id/divider_item_reminder"
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:background="?android:attr/listDivider"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/text_item_reminder_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:padding="2dp"
                android:text="@{data.reminder.timeDisplayString}"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="18sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/image_item_reminder_status"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/divider_item_reminder"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.533"
                tools:text="6:15 AM" />

            <ImageView
                android:id="@+id/image_item_reminder_status"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:contentDescription="@string/notification_icon_description"
                app:layout_constraintBottom_toBottomOf="@+id/text_item_reminder_time"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/text_item_reminder_time"
                app:layout_constraintTop_toTopOf="@+id/text_item_reminder_time"
                app:statusForIcon="@{data.history}"
                tools:srcCompat="@drawable/ic_notification_pending" />

            <TextView
                android:id="@+id/text_item_reminder_until"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingBottom="1dp"
                android:text="@string/item_reminder_until"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/textSize_item_reminder_date"
                app:layout_constraintBottom_toBottomOf="@+id/text_item_reminder_startDate"
                app:layout_constraintEnd_toStartOf="@+id/text_item_reminder_endDate"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/text_item_reminder_startDate"
                app:layout_constraintTop_toTopOf="@+id/text_item_reminder_startDate" />

            <TextView
                android:id="@+id/text_item_reminder_endDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingBottom="1dp"
                android:text="@{data.reminder.schedulingRules.endDateDisplayString()}"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/textSize_item_reminder_date"
                app:layout_constraintBottom_toBottomOf="@+id/text_item_reminder_until"
                app:layout_constraintEnd_toStartOf="@+id/divider_item_reminder"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/text_item_reminder_until"
                app:layout_constraintTop_toTopOf="@+id/text_item_reminder_until"
                tools:text="9/6/21" />

            <androidx.constraintlayout.widget.Group
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:visibility="@{data.reminder.schedulingRules.type != SchedulingType.SINGLE ? View.VISIBLE : View.GONE}"
                app:constraint_referenced_ids="text_item_reminder_until,text_item_reminder_endDate"
                tools:layout_editor_absoluteX="129dp"
                tools:layout_editor_absoluteY="70dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </com.google.android.material.card.MaterialCardView>


</layout>