<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View" />
        <import type="androidx.lifecycle.LiveData"/>
        <import type="com.github.jeremyt135.reminderapp.data.domain.SnoozeRules"/>
        <variable
            name="model"
            type="com.github.jeremyt135.reminderapp.screens.reminder.editor.dialog.SnoozeOptionsViewModel" />
        <variable
            name="snoozeRules"
            type="LiveData&lt;SnoozeRules&gt;" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_dialogSnooze_maxSnoozeRepeats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="@{model.canSnooze &amp;&amp; snoozeRules.maxRepeats != Long.MAX_VALUE ? View.VISIBLE : View.GONE}"
            app:constraint_referenced_ids="text_dialogSnooze_maxSnoozeRepeatsLabel, edit_dialogSnooze_maxSnoozeRepeats" />

        <TextView
            android:id="@+id/text_dialogSnooze_maxSnoozeRepeatsLabel"
            android:layout_width="124dp"
            android:layout_height="45dp"
            android:layout_marginStart="16dp"
            android:ems="10"
            android:gravity="center_vertical"
            android:text="@string/dialogSnooze_label_maxSnoozeRepeats"
            app:layout_constraintBottom_toBottomOf="@+id/edit_dialogSnooze_maxSnoozeRepeats"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/edit_dialogSnooze_maxSnoozeRepeats" />

        <EditText
            android:id="@+id/edit_dialogSnooze_maxSnoozeRepeats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ems="4"
            android:gravity="center_horizontal"
            android:inputType="numberSigned"
            android:maxLength="2"
            android:maxLines="1"
            android:text="@{`` + snoozeRules.maxRepeats}"
            app:layout_constraintStart_toEndOf="@+id/text_dialogSnooze_maxSnoozeRepeatsLabel"
            app:layout_constraintTop_toBottomOf="@+id/radioGroup_dialogSnooze_snoozeOptions" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_dialogSnooze_snoozeDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="@{model.canSnooze &amp;&amp; snoozeRules.maxRepeats > 0 ? View.VISIBLE : View.GONE}"
            app:constraint_referenced_ids="text_dialogSnooze_snoozeDurationLabel, edit_dialogSnooze_snoozeDuration" />

        <EditText
            android:id="@+id/edit_dialogSnooze_snoozeDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ems="4"
            android:gravity="center_horizontal"
            android:inputType="numberSigned"
            android:maxLength="2"
            android:maxLines="1"
            android:text="@{`` + snoozeRules.duration}"
            app:layout_constraintStart_toEndOf="@+id/text_dialogSnooze_snoozeDurationLabel"
            app:layout_constraintTop_toBottomOf="@+id/edit_dialogSnooze_maxSnoozeRepeats" />

        <TextView
            android:id="@+id/text_dialogSnooze_snoozeDurationLabel"
            android:layout_width="124dp"
            android:layout_height="45dp"
            android:layout_marginStart="16dp"
            android:ems="10"
            android:gravity="center_vertical"
            android:text="@string/dialogSnooze_label_snoozeDuration"
            app:layout_constraintBottom_toBottomOf="@+id/edit_dialogSnooze_snoozeDuration"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/edit_dialogSnooze_snoozeDuration" />

        <TextView
            android:id="@+id/text_dialogSnooze_unitsLabel"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:gravity="center_vertical"
            android:text="@string/dialogSnooze_label_snoozeDurationUnit"
            app:layout_constraintBottom_toBottomOf="@+id/edit_dialogSnooze_snoozeDuration"
            app:layout_constraintStart_toEndOf="@+id/edit_dialogSnooze_snoozeDuration"
            app:layout_constraintTop_toTopOf="@+id/edit_dialogSnooze_snoozeDuration" />

        <RadioGroup
            android:id="@+id/radioGroup_dialogSnooze_snoozeOptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView2">

            <RadioButton
                android:id="@+id/radioButton_dialogSnooze_never"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialogSnooze_option_neverSnooze" />

            <RadioButton
                android:id="@+id/radioButton_dialogSnooze_always"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialogSnooze_option_alwaysSnooze" />

            <RadioButton
                android:id="@+id/radioButton_dialogSnooze_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialogSnooze_option_number" />
        </RadioGroup>

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="@string/dialogSnooze_snoozeOptions_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:text="@string/dialogSnooze_duration_caption"
            style="@style/TextAppearance.AppCompat.Caption"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edit_dialogSnooze_snoozeDuration" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>