<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="history"
            type="app.timetoremind.mobile.data.domain.History" />
    </data>


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_item_history"
        style="@style/Widget.App.RecyclerList.Card"
        app:cardElevation="@dimen/recycler_item_cardView_elevation">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_card_item_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/recycler_item_padding_h"
            android:paddingVertical="@dimen/recycler_item_padding_v">

            <TextView
                android:id="@+id/text_item_history_completedDate"
                style="@style/TextAppearance.MaterialComponents.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="2dp"
                app:layout_constraintBottom_toBottomOf="@+id/text_item_history_time"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/text_item_history_time"
                tools:text="9/5/21" />

            <TextView
                android:id="@+id/text_item_history_description"
                style="@style/TextAppearance.MaterialComponents.Body1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:ellipsize="end"
                android:paddingHorizontal="2dp"
                android:paddingVertical="2dp"
                android:scrollHorizontally="false"
                android:text="@{history.description}"
                app:layout_constraintBottom_toTopOf="@+id/text_history_placeholder"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_item_history_time"
                app:layout_constraintWidth_percent="0.95"
                tools:text="Reminder text that is an example and is long enough for ellipses" />

            <TextView
                android:id="@+id/text_item_history_time"
                style="@style/TextAppearance.MaterialComponents.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="2dp"
                android:text="@{history.timeDisplayString}"
                app:layout_constraintBottom_toTopOf="@+id/text_item_history_description"
                app:layout_constraintEnd_toStartOf="@+id/text_item_history_completedDate"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0"
                app:layout_constraintVertical_chainStyle="spread_inside"
                tools:text="6:15 AM" />


            <ImageView
                android:id="@+id/image_item_history_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/notification_icon_description"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_item_history_description"
                app:layout_constraintVertical_bias="1.0"
                app:statusForIcon="@{history}"
                tools:srcCompat="@drawable/ic_notification_pending"
                tools:tint="@color/status_complete" />

            <TextView
                android:id="@+id/text_history_placeholder"
                style="@style/TextAppearance.MaterialComponents.Caption"
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="?android:attr/listDivider"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_item_history_description"
                tools:visibility="visible" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</layout>