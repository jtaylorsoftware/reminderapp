<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.App.Button.Compact" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">16dp</item>
        <item name="android:insetBottom">16dp</item>
        <item name="android:insetLeft">8dp</item>
        <item name="android:insetRight">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">16dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button.Compact</item>
    </style>

    <style name="Widget.App.Button.Compact.Round" parent="Widget.App.Button.Compact">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.Button.Round50</item>
    </style>

    <style name="TextAppearance.App.Button.Compact" parent="TextAppearance.MaterialComponents.Button">
        <item name="textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.033</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.Button.Round50" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="TextAppearance.App.Calendar.Heading" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.App.Calendar.Date" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.App.Calendar.YearMonth" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Widget.App.Button.BottomNav" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="iconGravity">textTop</item>
        <item name="iconPadding">@dimen/bottomNav_iconPadding</item>
        <item name="iconSize">24dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:paddingStart">@dimen/bottomNav_paddingStart</item>
        <item name="android:paddingEnd">@dimen/bottomNav_paddingEnd</item>
        <item name="android:minWidth">@dimen/bottomNav_minWidth</item>
        <item name="android:maxWidth">@dimen/bottomNav_maxWidth</item>
        <item name="layout_constraintWidth_min">@dimen/bottomNav_minWidth</item>
        <item name="layout_constraintWidth_max">@dimen/bottomNav_maxWidth</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">?attr/colorOnPrimarySurface</item>
        <item name="android:maxHeight">@dimen/bottom_app_bar_height</item>
        <item name="layout_constraintHeight_max">@dimen/bottom_app_bar_height</item>
        <item name="iconTint">?attr/colorControlNormal</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button.BottomNav</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.Button.NoCorners</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.Button.NoCorners" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <style name="TextAppearance.App.Button.BottomNav" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:textSize">@dimen/bottomNav_textSize</item>
    </style>

    <style name="Widget.App.CardView.Calendar" parent="Widget.MaterialComponents.CardView">
        <item name="strokeColor">@null</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="android:backgroundTint">@color/calendar_card_tint</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.CardView.Calendar</item>
    </style>

    <style name="Widget.App.CardView.Calendar.ReminderList" parent="Widget.MaterialComponents.CardView">
        <item name="strokeColor">@null</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="android:backgroundTint">@color/transparent</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.CardView.Calendar</item>
    </style>

    <style name="ShapeAppearance.App.CardView.Calendar" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">0dp</item>
    </style>

    <style name="Widget.App.RecyclerList.Card" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">@dimen/recycler_item_width</item>
        <item name="android:layout_height">@dimen/recycler_item_height</item>
        <item name="android:layout_margin">8dp</item>
        <item name="cardElevation">@dimen/recycler_item_cardView_elevation</item>
    </style>

    <style name="Widget.App.RecyclerList.Divider" parent="">
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_width">@dimen/recycler_item_width</item>
        <item name="android:layout_margin">8dp</item>
    </style>

    <style name="Widget.App.RecyclerList.Divider.Title" parent="">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">@dimen/recycler_item_width</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:textAppearance">@style/TextAppearance.MaterialComponents.Caption</item>
    </style>

    <style name="Widget.App.RecyclerList.Hint" parent="Widget.MaterialComponents.TextView">
        <item name="android:textAppearance">@style/TextAppearance.MaterialComponents.Body2</item>
        <item name="android:maxWidth">@dimen/recycler_item_width</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">left</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>

    <style name="Widget.App.TextInputLayout.OutlinedBox.Editor" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="layout_constraintWidth_max">460dp</item>
    </style>

    <style name="Widget.App.Calendar.ReminderItem" parent="Widget.App.RecyclerList.Card">
        <item name="android:layout_width">@dimen/recycler_item_calendar_width</item>
    </style>
</resources>